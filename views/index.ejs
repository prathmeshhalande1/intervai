<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>IntervAI</title>
  <link rel="stylesheet" href="/stylesheet/index.css" />
  <link rel="icon" href="favicon.ico" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet" />
  <script src="/node_modules/gsap/dist/gsap.min.js"></script>
  <script src="/node_modules/gsap/dist/ScrollTrigger.min.js"></script>
  <script src="/node_modules/gsap/dist/ScrollSmoother.min.js"></script>
  <script src="/node_modules/jquery/dist/jquery.min.js"></script>
</head>

<body>
  <div class="page_container">
    <div class="navContainer">
      <div class="navTopContainer">
        <div class="icon"></div>
      <div class="burgar">
        <div class="line1"></div>
        <div class="line2"></div>
      </div>
      </div>
      <div class="navlocation">
        <a href="">Home</a><br>
        <a href="">Profile</a><br>
        <a href="">IntervAI</a><br>
        <a href="">quize</a><br>
        <a href="/loginAndSignup">log-in/sign-up</a><br>
      </div>
      <div class="linecontainer"><div class="line3"></div></div>
      
    </div>

    <div class="page1">
      <div class="container_1">
        <div class="tagline_1">
          <span>✨ Voice-powered AI interview practice</span>
        </div>
        <h1 class="main-title">Ace your next interview!</h1>
        <p class="description">
          Talk with our personalised AI powered interview coach. Practice<br>
          in a real-time interview and get actionable feedback.<br>
          The world's most powerful AI interviewer.
        </p>
        <button class="start-btn">
          Start my interview <span class="arrow">🡵</span>
        </button>
      </div>
    </div>

    <!-- Page 2 -->
    <div class="page2">
      <div class="container_2">
        <div class="animated-bg"></div>

        <div class="card-wrapper">
          <!-- AI Interview Chat Cards -->
          <div class="card float-up">
            <p class="question">AI: Tell me about yourself.</p>
            <p class="answer">I’m a CS student with strong coding skills and a passion for AI.</p>
          </div>

          <div class="card float-left">
            <p class="question">AI: Why do you want this role?</p>
            <p class="answer">I want to build real-world scalable solutions with your amazing team.</p>
          </div>

          <div class="card float-down">
            <p class="question">AI: Describe a challenge you overcame.</p>
            <p class="answer">I led a project under pressure and improved performance by 40%.</p>
          </div>

          <div class="card float-right">
            <p class="question">AI: Any final thoughts?</p>
            <p class="answer">AI mock interviews helped boost my confidence and get this job!</p>
          </div>
        </div>
      </div>
    </div>


    <!-- Page 3 -->
    <div class="page3">
      <div class="container_3">
        <div class="tagline_3">
          <span>Personalised to you and your job</span>
        </div>
        <h2>Instant personalised interviews</h2>
        <p>
          Import your job from any job site, like Indeed or LinkedIn. Upload your CV. Our AI interviewer will
          personalise your questions, making the interview just like real life.
        </p>
        <h5><span>✓</span> Tailored to your CV</h5>
        <h5><span>✓</span> Personalised to your job</h5><br>
        <h3>Start my interview now</h3>

        <div class="card">
          <img src="images/icon-download-pdf-removebg-preview.png" alt="PDF Icon" />
          <div class="card-content">
            <h4>CV uploaded</h4>
            <p>👍We will ask you about your experience</p>
          </div>
        </div>

        <div class="card">
          <img src="" alt="Job Icon" />
          <div class="card-content">
            <h4>Job listing imported</h4>
            <p>Realistic technical questions</p>
          </div>
        </div>

        <div class="job-tooltip">
          <div class="tooltip-arrow"></div>
          <div class="tooltip-bubble">Import job listing</div>
        </div>

        <div class="card">
          <img src="" alt="Difficulty Icon" />
          <div class="card-content">
            <h4>Set your difficulty</h4>
            <p>Progress and improve</p>
          </div>
        </div>
      </div>
    </div>

    <div class="page4">
      <div class="container_4">
        <div class="tagline_4">
          <span>Feedback</span>
        </div>
        <h2>Get actionable, constructive feedback</h2>
        <p>
          We give you actionable constructive feedback, so you can improve your interview technique. Work your way up
          from easy mode to hard mode to perfect your answers.
        </p>
        <h5><span>✓</span>Direct feedback</h5>
        <h5><span>✓</span> 4 difficulty levels</h5><br>
        <h3>See Pricing</h3>
        <div class="feedback-bars">
          <div class="bar-container green">
            <span>Communication</span>
            <div class="bar-bg">
              <div class="bar-fill" style="width: 80%;"></div>
            </div>
          </div>

          <div class="bar-container purple">
            <span>Cultural fit</span>
            <div class="bar-bg">
              <div class="bar-fill" style="width: 75%;"></div>
            </div>
          </div>

          <div class="bar-container red">
            <span>Problem solving</span>
            <div class="bar-bg">
              <div class="bar-fill" style="width: 85%;"></div>
            </div>
          </div>

          <div class="bar-container blue">
            <span>Technical ability</span>
            <div class="bar-bg">
              <div class="bar-fill" style="width: 90%;"></div>
            </div>
          </div>
        </div>

      </div>
    </div>

    <div class="page5">
      <div class="container_5">
        <div class="tagline_5">
          <span>Get the job you deserve!</span>
        </div>
        <h2 class="section-title">Practice makes perfect</h2>
        <p class="section-subtext">
          Work your way up through the levels of our AI powered interview coach. Get actionable feedback on your weak
          areas, and perfect your strengths.
        </p>

        <div class="features-grid">
          <div class="feature-box">
            <div class="icon-circle">
              <img src="icons/voice-icon.svg" alt="Voice Chat Icon" />
            </div>
            <h3>Voice chat</h3>
            <p>Our realistic voice chat feels just like a real interview.</p>
            <span class="badge green">Realistic voice chat</span>
          </div>

          <div class="feature-box">
            <div class="icon-circle">
              <img src="icons/brain-icon.svg" alt="Brain Icon" />
            </div>
            <h3>Powerful interviewer</h3>
            <p>Our AI interviewer will question you on everything from job-specific technicalities to items on your
              résumé.</p>
            <span class="badge blue">Find holes in your CV</span>
          </div>

          <div class="feature-box">
            <div class="icon-circle">
              <img src="icons/thumb-icon.svg" alt="Feedback Icon" />
            </div>
            <h3>Constructive feedback</h3>
            <p>Get honest constructive feedback from our intelligent interview model.</p>
            <span class="badge orange">Improve your technique</span>
          </div>

          <div class="feature-box">
            <div class="icon-circle">
              <img src="icons/graph-icon.svg" alt="Graph Icon" />
            </div>
            <h3>Get better</h3>
            <p>Work your way up from easy to hard mode mastering your interview technique.</p>
            <span class="badge purple">Master each difficulty level</span>
          </div>
        </div>
      </div>
    </div>

    <div class="page6">
      <div class="container_6">
        <div class="tagline_6">Testimonials</div>
        <h1 class="testimonial-heading">Do you want to be the only candidate that didn’t prepare?</h1>

        <div class="testimonial-wrapper">
          <div class="testimonial-card">
            <img src="https://i.ibb.co/n0dTkqn/avatar1.jpg" alt="Katya Samson" class="testimonial-img">
            <div class="testimonial-name">Katya Samson</div>
            <div class="testimonial-role">Dentist</div>
            <div class="testimonial-text">Bossed really put me through my paces. It helped me get a job in a practice I
              love!</div>
          </div>

          <div class="testimonial-card">
            <img src="https://i.ibb.co/XxX4c2Y/avatar-placeholder.png" alt="Anonymous" class="testimonial-img">
            <div class="testimonial-name">Anonymous</div>
            <div class="testimonial-role">Analyst</div>
            <div class="testimonial-text">I was super nervous for my interview but practicing really helped!</div>
          </div>
        </div>
      </div>
    </div>

  </div>

</body>


<script src="/javascript/gsap/indexGsap.js"></script>

</html>